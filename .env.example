# Copy to `.env` for local development. Never commit real values.
# Production values live in Netlify (Site configuration → Environment variables).

# --- Core ---
PAYLOAD_SECRET=                # openssl rand -hex 32 (different value per environment)
DATABASE_URI=                  # postgres://user:pass@host:5432/db (local Postgres for dev). On Netlify: Supabase *Transaction* pooler, port 6543 (the Session pooler runs out of connections)
NEXT_PUBLIC_SITE_URL=          # http://localhost:3000 in dev; https://www.ethicai.au in prod (canonical URL for metadata, redirects and admin preview links)

# --- Media (S3-compatible, e.g. Cloudflare R2) — required; uploads never touch local disk ---
S3_BUCKET=                     # bucket name, e.g. ethicai-media
S3_REGION=auto                 # R2 uses "auto"
S3_ENDPOINT=                   # https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=              # R2 API token (Object Read & Write, scoped to the bucket)
S3_SECRET_ACCESS_KEY=          # R2 API token secret
S3_PUBLIC_URL=                 # public bucket URL (https://pub-xxxx.r2.dev or https://media.ethicai.au); files are served from here

# --- Integrations ---
# DECISION: none. The Elfsight TikTok widget ID, Substack URL, TikTok handle and YouTube channel are
# set in the admin (Site settings), so changing them never needs a redeploy (AGENTS.md #2). The
# spec's NEXT_PUBLIC_ELFSIGHT_TIKTOK_ID / NEXT_PUBLIC_SUBSTACK_URL fallbacks are deliberately not read.

# --- Ops ---
REVALIDATE_SECRET=             # optional: enables POST /api/revalidate for scripts/manual refreshes (openssl rand -hex 32); publishing revalidates without it
CRON_SECRET=                   # shared secret for /api/sync-youtube (Milestone 7 only)
NEXT_PUBLIC_RUNBOOK_URL=       # optional: runbook link on the admin dashboard

# --- First deploy only (set in Netlify, then remove: docs/DEPLOYMENT-NETLIFY.md §3a) ---
BOOTSTRAP_ADMIN_EMAIL=         # the build creates the first admin from these two, only if the site has no users, so nobody else can claim /admin first
BOOTSTRAP_ADMIN_PASSWORD=      # 12+ characters. Change it after the first sign-in, then delete both variables
BOOTSTRAP_ADMIN_NAME=          # optional display name (default "EthicAI admin")
SEED_DEMO_CONTENT=             # "true" adds the team, testimonials and two demo articles during the build (review site only). Deleted demo content returns on every build while this is on

# --- Testing (local only) ---
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=   # optional: run e2e tests with an installed Chromium instead of `npx playwright install`
